        DAYS[jDay] + ' ' + fa(j.jd) + ' ' + MONTHS[j.jm-1] + ' ' + fa(j.jy);

      // ✅ نمایش ذکر روز
      document.getElementById('dhikr-box').textContent = dailyDhikrs[jDay];

      var holidayKey = gm + "-" + gd;
      var occasionEl = document.getElementById('occasion-box');
      if (holidays[holidayKey]) {
        occasionEl.textContent = "📅 " + holidays[holidayKey];
      } else {
        occasionEl.textContent = ""; 
      }

      var config = dailyConfig[jDay];
      document.getElementById('daily-quote').textContent = config.quote;
      
      var icons = generateIcons(config.color);
      document.getElementById('prayer-grid').innerHTML = `
        <div class="prayer-box"><span class="prayer-icon">${icons.fajr}</span><span class="prayer-label">اذان صبح</span><span class="prayer-time" id="fajr">--:--</span></div>
        <div class="prayer-box"><span class="prayer-icon">${icons.sunrise}</span><span class="prayer-label">طلوع آفتاب</span><span class="prayer-time" id="sunrise">--:--</span></div>
        <div class="prayer-box"><span class="prayer-icon">${icons.dhuhr}</span><span class="prayer-label">اذان ظهر</span><span class="prayer-time" id="dhuhr">--:--</span></div>
        <div class="prayer-box"><span class="prayer-icon">${icons.maghrib}</span><span class="prayer-label">اذان مغرب</span><span class="prayer-time" id="maghrib">--:--</span></div>
      `;

      var xhr = new XMLHttpRequest();
      xhr.open('GET', `https://api.aladhan.com/v1/timings/${gd}-${gm}-${gy}?latitude=28.4414&longitude=56.3728&method=5&school=1`, true);
      xhr.timeout = 10000;
      xhr.onload = function() {
        if (xhr.status === 200) {
          try {
            var t = JSON.parse(xhr.responseText).data.timings;
            const fix = (s, add) => {
              var p = s.split(' ')[0].split(':');
              var total = ((parseInt(p[0]) * 60 + parseInt(p[1]) + add) % 1440 + 1440) % 1440;
              return fa(Math.floor(total / 60)) + ':' + fa(String(total % 60).padStart(2, '0'));
            };
            document.getElementById('fajr').textContent = fix(t.Fajr, 10);
            document.getElementById('sunrise').textContent = fix(t.Sunrise, 0);
            document.getElementById('dhuhr').textContent = fix(t.Dhuhr, 0);
            document.getElementById('maghrib').textContent = fix(t.Maghrib, 18);
          } catch(e) { setFallback(); }
        } else setFallback();
      };
      xhr.onerror = xhr.ontimeout = setFallback;
      xhr.send();

      function setFallback() {
        document.getElementById('fajr').textContent = fa(3)+':'+fa('43');
        document.getElementById('sunrise').textContent = fa(5)+':'+fa('08');
        document.getElementById('dhuhr').textContent = fa(11)+':'+fa('51');
        document.getElementById('maghrib').textContent = fa(18)+':'+fa('51');
      }

      var wx = new XMLHttpRequest();
      wx.open('GET', 'https://api.open-meteo.com/v1/forecast?latitude=28.4414&longitude=56.3728&daily=temperature_2m_max,temperature_2m_min,weathercode,precipitation_probability_max&timezone=Asia/Tehran&forecast_days=2', true);
      wx.timeout = 10000;
      wx.onload = function() {
        var box = document.getElementById('weather-box');
        if (wx.status === 200) {
          try {
            var d = JSON.parse(wx.responseText).daily;
            var code = d.weathercode[1], max = Math.round(d.temperature_2m_max[1]), min = Math.round(d.temperature_2m_min[1]), rain = d.precipitation_probability_max[1] || 0;
            
            var wColor = config.color;
            var weatherSVG = code <= 1 ? 
              `<svg class="weather-icon-svg" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="5" fill="${wColor}"/><g stroke="${wColor}" stroke-width="2" stroke-linecap="round"><line x1="12" y1="1" x2="12" y2="3.5"/><line x1="12" y1="20.5" x2="12" y2="23"/><line x1="1" y1="12" x2="3.5" y2="12"/><line x1="20.5" y1="12" x2="23" y2="12"/></g></svg>` :
              code <= 3 ?
              `<svg class="weather-icon-svg" viewBox="0 0 24 24" fill="none"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" fill="${wColor}" opacity="0.85"/></svg>` :
              `<svg class="weather-icon-svg" viewBox="0 0 24 24" fill="none"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" fill="${wColor}" opacity="0.6"/><g stroke="${wColor}" stroke-width="2" stroke-linecap="round"><line x1="8" y1="19" x2="8" y2="22"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="16" y1="19" x2="16" y2="22"/></g></svg>`;
            
            var descs = {0:'آفتابی',1:'صاف',2:'نیمه‌ابری',3:'ابری',45:'مه',51:'نم‌نم',61:'بارانی',71:'برفی',80:'رگبار',95:'طوفانی'};
            
            box.innerHTML = `<div class="weather-main">${weatherSVG}<div><div class="weather-temp">${fa(min)}° تا ${fa(max)}°</div><div class="weather-desc">${descs[code]||'متغیر'}</div></div></div>
              <div class="weather-details"><div class="weather-det-item">حداکثر<span>${fa(max)}°</span></div><div class="weather-det-item">حداقل<span>${fa(min)}°</span></div><div class="weather-det-item">بارش<span>${fa(rain)}٪</span></div></div>`;
          } catch(e) { box.innerHTML = '<div style="color:#718096;text-align:center;padding:6px;font-size:0.8rem;">داده در دسترس نیست</div>'; }
        } else box.innerHTML = '<div style="color:#718096;text-align:center;padding:6px;font-size:0.8rem;">خطا در دریافت</div>';
      };
      wx.onerror = () => document.getElementById('weather-box').innerHTML = '<div style="color:#718096;text-align:center;padding:6px;font-size:0.8rem;">اتصال اینترنت بررسی شود</div>';
      wx.ontimeout = () => document.getElementById('weather-box').innerHTML = '<div style="color:#718096;text-align:center;padding:6px;font-size:0.8rem;">زمان انتظار تمام شد</div>';
      wx.send();
    })();

    function downloadPNG() {
      var btn = document.querySelector('.download-btn');
      btn.style.display = 'none';
      
      document.fonts.ready.then(() => {
        domtoimage.toPng(document.getElementById('story-card'), {
          quality: 1.0,
          bgcolor: '#ffffff',
          width: 1080, height: 1920,
          style: { transform: 'scale(3)', transformOrigin: 'top left', width: '360px', height: '640px' },
          cacheBust: true
        }).then(dataUrl => {
          var link = document.createElement('a');
          link.download = `arzuiyeh_${new Date().toISOString().slice(0,10)}.png`;
          link.href = dataUrl;
          link.click();
          btn.style.display = 'block';
        }).catch(err => { console.error(err); alert('خطا در تولید تصویر'); btn.style.display = 'block'; });
      });
    }
  </script>
</body>
</html>

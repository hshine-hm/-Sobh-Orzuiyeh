    (function() {
      var start = new Date(Date.UTC(2026, 7, 5));
      var now = new Date();
      var todayUTC = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
      var diffDays = Math.floor((todayUTC - start) / 86400000);
      if (diffDays < 0) diffDays = 0;
      
      var tomorrow = new Date(start);
      tomorrow.setUTCDate(start.getUTCDate() + diffDays + 1);
      
      var gy = tomorrow.getUTCFullYear(), gm = tomorrow.getUTCMonth() + 1, gd = tomorrow.getUTCDate();

      function jalali(y, m, d) {
        var gdm = [0,31,59,90,120,151,181,212,243,273,304,334];
        var jy = y <= 1600 ? 0 : 979;
        y -= y <= 1600 ? 621 : 1600;
        var y2 = m > 2 ? y + 1 : y;
        var days = 365*y + ~~((y2+3)/4) - ~~((y2+99)/100) + ~~((y2+399)/400) - 80 + d + gdm[m-1];
        jy += 33 * ~~(days/12053); days %= 12053;
        jy += 4 * ~~(days/1461); days %= 1461;
        if (days > 365) { jy += ~~((days-1)/365); days = (days-1)%365; }
        var jm = days < 186 ? 1 + ~~(days/31) : 7 + ~~((days-186)/30);
        var jd = days < 186 ? 1 + days%31 : 1 + (days-186)%30;
        return {jy, jm, jd};
      }

      var j = jalali(gy, gm, gd);
      var jDay = ((tomorrow.getUTCDay() + 1) % 7);
      var DAYS = ['شنبه','یکشنبه','دوشنبه','سه‌شنبه','چهارشنبه','پنجشنبه','جمعه'];
      var MONTHS = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];

